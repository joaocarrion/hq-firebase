  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "devDependencies": {
    "@types/node": "^22.15.29",
    "firebase": "^11.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "private": true,
  "dependencies": {
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.4.0"
  }
}
