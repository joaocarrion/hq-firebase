rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    match /diagnostics/{docId} {
    	allow create: if request.auth != null
    }
    
    match /meta/{docId} {
      allow read, write: if request.auth != null;
    }

    match /collectionVersions/{docId} {
  		allow create: if request.auth != null
    			&& request.resource.data.version is int
    			&& request.resource.data.version == 1;

  		allow update: if request.auth != null
    			&& request.resource.data.version is int
    			&& resource.data.version is int
    			&& request.resource.data.version == resource.data.version + 1;

  		allow read: if request.auth != null;
		}
    
    match /importErrors/{document=**} {
    	allow write: if request.auth != null;
    }

    match /public/latest/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /public/latest/updatedProducts/{document=**} {
      allow create: if isGroupMember(request.resource.data.group);
      allow read, write: if isGeneralManager();
    }

    match /public/latest/updatedCategories/{document=**} {
      allow create: if isGroupMember(request.resource.data.group);
      allow read, write: if isGeneralManager();
    }

    match /public/latest/updatedStores/{document=**} {
      allow create: if isGroupMember(request.resource.data.group);
      allow read, write: if isGeneralManager();
    }

    match /user_profiles/{userId} {
			allow read: if request.auth != null && request.auth.uid == resource.data.id;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /user_profiles/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId
    }

    match /invitations/{$id} {
      allow get: if request.auth != null;
    }
    
    // Groups Collection
    match /groups/{groupId} {
      allow create: if request.auth != null; // Anyone can create a group

			allow read: if request.auth != null && request.auth.uid in resource.data.users;
      // allow read: if isGroupMember(groupId);
      allow update, delete: if isGroupAdmin();
    }

    // Group Data
    match /groups/{groupId}/{document=**} {
      allow read, write: if isGroupMember(groupId);
    }

    // Helper Functions
    function isGroupMember(groupId) {
      let groupData = get(/databases/$(database)/documents/groups/$(groupId)).data;
      return request.auth != null && 
            request.auth.uid in groupData.users;
    }

    function isGroupAdmin() {
      return request.auth != null && request.auth.uid in resource.data.admins;
    }

    function isGeneralManager() {
      return request.auth != null && (request.auth.token.email == 'joao.carrion@gmail.com' ||
      	request.auth.token.email == 'silvia_am@hotmail.com' ||
        request.auth.token.email == 'joao.carrion+1@gmail.com');
    }

    // function canInvite(groupId) {
    //   return request.auth != null &&
    //      request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.admins
    // }
  }
}
